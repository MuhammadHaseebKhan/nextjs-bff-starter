# Copy to .env.local. None of these are ever sent to the browser (no NEXT_PUBLIC_ prefix).

# Base URL of the upstream API the BFF talks to.
# The default points at the built-in mock upstream so the app runs with zero external services.
UPSTREAM_API_URL=http://localhost:3000/mock-upstream

# Credential the BFF injects into every upstream request. The browser never sees it.
UPSTREAM_API_KEY=local-dev-key

# Upstream request timeout in milliseconds.
UPSTREAM_TIMEOUT_MS=5000
